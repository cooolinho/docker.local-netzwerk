# Docker Local Network Environment Configuration
# ================================================

# Domain configuration
DOMAIN=docker.lan
DOCKER_HOST=192.168.178.6

# Network configuration
DOCKER_NETWORK=docker_lan_network

# Traefik configuration
TRAEFIK_DASHBOARD_USER=admin
BACKUP_RETENTION_DAYS=30
TRAEFIK_API_PORT=8081

# Separate read-only credentials for monitoring API (/api/http/services/*)
TRAEFIK_API_MONITOR_USER=monitor-api
BACKUP_RETENTION_DAYS=30

# SSL/TLS configuration (selbstsigniertes Zertifikat für lokal)
SSL_ENABLED=false
# Für Let's Encrypt in Zukunft:
# SSL_ENABLED=true
# LETSENCRYPT_EMAIL=your-email@example.com

# Logging
LOG_LEVEL=INFO
TRAEFIK_LOG_LEVEL=INFO

# Projects - Ports für direkte Verbindung (falls nötig)
DASHY_PORT=3000
IT_TOOLS_PORT=3001
PLANKA_PORT=3002
PORTAINER_PORT=9000
PRIVATE_PROJECT_1_PORT=3003
PRIVATE_PROJECT_2_PORT=3004
PRIVATE_PROJECT_3_PORT=3005

# ================================================
# Backup Configuration
# ================================================

# Retention period for automatic backup cleanup (in days)
BACKUP_RETENTION_DAYS=30

# Cron schedule for automatic backups (default: daily at 02:00 AM)
# Format: minute hour day month weekday
# Example: "0 2 * * *" = 02:00 AM every day
# Example: "0 3 * * 0" = 03:00 AM every Sunday
BACKUP_SCHEDULE="0 2 * * *"

