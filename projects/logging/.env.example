# Logging-Stack – Umgebungsvariablen
# ====================================
# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env Datei wird NICHT in Git eingecheckt!

# Grafana Admin-Zugangsdaten
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Zeitzone
TZ=Europe/Berlin

# Docker Compose Environment
TRAEFIK_PORT=3000
TRAEFIK_SERVICE_NAME=grafana
TRAEFIK_DOMAIN=docker.lan
DOCKER_NETWORK=docker_lan_network
