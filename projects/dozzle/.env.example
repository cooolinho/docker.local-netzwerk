# Dozzle – Umgebungsvariablen
# ============================
# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env Datei wird NICHT in Git eingecheckt!

# Zeitzone
TZ=Europe/Berlin

# Docker Compose Environment
TRAEFIK_PORT=8080
TRAEFIK_SERVICE_NAME=dozzle
TRAEFIK_DOMAIN=docker.lan
DOCKER_NETWORK=docker_lan_network
